# FlowBrowse 单一服务端单元（HTTPS 转发代理 + 站点 + 订阅 + WebTransport + autocert）
# 一个进程监听 TCP80(ACME)/TCP443(代理+站点+订阅)/UDP443(WebTransport)；证书由程序内 autocert 自动申请续期。
[Unit]
Description=FlowBrowse server (https forward proxy + webtransport + site)
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=flowbrowse
Group=flowbrowse
EnvironmentFile=/etc/flowbrowse/.env
ExecStart=/opt/flowbrowse/bin/flowbrowse-server
Restart=always
RestartSec=5
# 非 root 绑定 80/443 特权端口
AmbientCapabilities=CAP_NET_BIND_SERVICE
CapabilityBoundingSet=CAP_NET_BIND_SERVICE
# autocert 证书缓存目录需归属服务用户
ReadWritePaths=/var/lib/flowbrowse
StandardOutput=journal
StandardError=journal

[Install]
WantedBy=multi-user.target
