# FlowBrowse Caddy 服务单元
# 作用：以带 forwardproxy 的 Caddy 提供 TCP 443 转发代理 + 默认站点 + 订阅文件；
#       automatic HTTPS 负责申请与自动续期 Let's Encrypt 证书。
[Unit]
Description=FlowBrowse Caddy (forward proxy + site + subscription)
After=network-online.target
Wants=network-online.target

[Service]
Type=notify
User=caddy
Group=caddy
# 域名/端口/凭据全部来自 .env，Caddyfile 用 {$VAR} 读取，零硬编码
EnvironmentFile=/etc/flowbrowse/.env
ExecStart=/usr/local/bin/caddy run --config /etc/flowbrowse/Caddyfile --adapter caddyfile
ExecReload=/usr/local/bin/caddy reload --config /etc/flowbrowse/Caddyfile --adapter caddyfile
Restart=on-failure
RestartSec=5
# 允许非 root 的 caddy 用户绑定 80/443 特权端口
AmbientCapabilities=CAP_NET_BIND_SERVICE
CapabilityBoundingSet=CAP_NET_BIND_SERVICE
StandardOutput=journal
StandardError=journal

[Install]
WantedBy=multi-user.target
