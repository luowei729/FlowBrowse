# FlowBrowse 服务端配置示例
# 真实值请写入 /etc/flowbrowse/.env（权限 600），切勿提交到仓库/入库/入日志。
# 域名与所有端口均可自定义；下面的 sel2.lkz.pub 仅为测试默认值。

# —— 域名与端口（全部可自定义）——
DOMAIN=sel2.lkz.pub              # 自有域名（测试默认），换成你的域名即可
ACME_EMAIL=admin@example.com     # Let's Encrypt 证书注册邮箱（autocert 用）
FB_TCP_PORT=443                  # 站点端口（TCP）：普通访问域名→空200首页 + 订阅文件（对外像个正常网站）
FB_PROXY_PORT=2096               # 转发代理端口（TCP，保密/非常规端口，防扫描）；插件连这个端口
FB_WT_PORT=443                   # WebTransport 端口（UDP，可自定义）
FB_ACME_PORT=80                  # autocert HTTP-01 验证端口（TCP，一般 80）

# —— 代理鉴权（Chrome 对 https 代理不支持扩展自动注入，默认关；靠保密端口隐蔽）——
# FB_PROXY_AUTH=on 才启用 BasicAuth（若改用 HTTP/SOCKS5 代理才能自动鉴权不弹框）
FB_PROXY_AUTH=off
AUTH_USER=fbuser
AUTH_PASS=CHANGE_ME_STRONG_PASSWORD

# —— 订阅密钥路径段（等价 token，改成随机长串；install.sh 若发现占位会自动生成）——
NODE_TOKEN=CHANGE_ME_LONG_RANDOM
# —— 订阅文件名（防嗅探：留占位则 install.sh 随机生成，也可自定义；建议用无扩展名随机串）——
FB_SUB_FILE=CHANGE_ME_SUBFILE

# —— 节点展示元数据 ——
NODE_NAME=FlowBrowse-Test
NODE_REGION=SG

# —— 静态站点根目录（默认页 + 订阅文件都放这里）——
FB_WEB_ROOT=/srv/flowbrowse

# —— 二进制获取方式（默认由 GitHub Actions 预编译，服务器不本地编译）——
# FB_BIN_MODE: prebuilt=仅下载预编译(默认，不在服务器编译) | auto=先下后编译 | build=仅本地编译（支持 amd64/arm64）
FB_BIN_MODE=prebuilt
# GitHub 仓库 owner/name（用于拼接 latest release 预编译下载直链）
FB_REPO=luowei729/FlowBrowse
# 可显式指定下载基址（优先级高于 FB_REPO）；例：https://github.com/your-org/FlowBrowse/releases/latest/download
FB_DL_BASE=

# —— 二进制与证书缓存目录（单一 Go 服务）——
SERVER_BIN=/opt/flowbrowse/bin/flowbrowse-server
# autocert 证书缓存目录（服务用户可读写）
FB_CERT_CACHE=/var/lib/flowbrowse/certcache
