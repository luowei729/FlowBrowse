# FlowBrowse 服务端配置示例（复制为 /etc/flowbrowse/env，权限 600）
# 原则：域名/端口/密钥全部可自定义，程序与脚本零硬编码。

# ===== 对外域名（A 记录指向服务器公网 IP；证书走 HTTP-01，需 80 可达）=====
DOMAIN=example.com

# ===== 可选 Basic 鉴权（默认关闭，靠 IP 白名单；开启会触发 Chrome 代理登录弹框，慎用）=====
AUTH_USER=<随机用户名>
AUTH_PASS=<随机密码>
FB_PROXY_AUTH=off

# ===== 订阅密钥路径段与随机文件名（防被嗅探枚举；install.sh 自动生成，可自定义）=====
NODE_TOKEN=<随机hex目录名>
FB_SUB_FILE=<随机hex文件名>

# ===== 端口（代理与订阅共用 TCP 443；ACME 用 TCP 80；已放弃 QUIC/UDP）=====
FB_TCP_PORT=443
FB_ACME_PORT=80

# ===== IP 白名单：拉到有效订阅 URL 的客户端 IP 自动放行（免密码、免弹框）=====
FB_PROXY_ALLOW=on
FB_PROXY_ALLOW_TTL_HOURS=720   # 放行有效期（小时），默认 30 天

# ===== 路径 =====
FB_WEB_ROOT=/srv/flowbrowse
FB_CERT_CACHE=/var/lib/flowbrowse/certcache

# ===== 节点展示元信息（仅用于生成订阅里的 name/region）=====
NODE_NAME=FlowBrowse-SG
NODE_REGION=SG
