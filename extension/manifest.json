{
  "manifest_version": 3,
  "name": "FlowBrowse",
  "version": "0.4.3",
  "description": "零本地客户端的浏览器代理：单端口 HTTPS 转发代理 + 节点订阅 + 国内外规则智能分流 + 一键连接（IP 白名单免弹框）。",

  "icons": {
    "16": "icons/icon-16.png",
    "32": "icons/icon-32.png",
    "48": "icons/icon-48.png",
    "128": "icons/icon-128.png"
  },

  "permissions": [
    "proxy",
    "storage",
    "unlimitedStorage",
    "alarms",
    "webRequest"
  ],

  "host_permissions": [
    "<all_urls>"
  ],

  "background": {
    "service_worker": "background/service-worker.js",
    "type": "module"
  },

  "action": {
    "default_popup": "popup/popup.html",
    "default_title": "FlowBrowse",
    "default_icon": {
      "16": "icons/icon-off-16.png",
      "32": "icons/icon-off-32.png",
      "48": "icons/icon-off-48.png"
    }
  },

  "options_ui": {
    "page": "options/options.html",
    "open_in_tab": true
  }
}
